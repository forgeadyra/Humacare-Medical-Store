---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import { business, telHref, whatsappHref } from '../data/business';
import { t, type Lang } from '../i18n/ui';
import { pathFor } from '../lib/routes';
import { pharmacySchema, breadcrumbSchema } from '../lib/schema';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);
const p = d.servicesPage;
const icons = { rx: 'rx', otc: 'pill', supplies: 'kit', advice: 'advice', delivery: 'delivery' } as const;

const schema = [
  pharmacySchema({ lang }),
  breadcrumbSchema([
    { name: d.breadcrumbs.home, path: pathFor('home', lang) },
    { name: d.breadcrumbs.services, path: pathFor('services', lang) },
  ]),
];
---

<Base lang={lang} routeKey="services" title={d.meta.services.title} description={d.meta.services.description} schema={schema}>
  <PageHeader lang={lang} current={d.breadcrumbs.services} eyebrow={p.eyebrow} title={p.h1} intro={p.intro}>
    <ul class="mt-8 flex flex-wrap gap-2">
      {
        p.sections.map((s) => (
          <li>
            <a href={`#${s.key}`} class="chip">
              <Icon name={icons[s.key as keyof typeof icons]} size={18} />
              {s.title}
            </a>
          </li>
        ))
      }
    </ul>
  </PageHeader>

  <div class="container-x grid gap-6 py-14 md:gap-8 md:py-20">
    {
      p.sections.map((s, i) => (
        <section id={s.key} class="svc-block card" aria-labelledby={`${s.key}-title`} data-reveal>
          <div class="grid gap-8 lg:grid-cols-[1.4fr_1fr] lg:gap-12">
            <div>
              <div class="flex items-center gap-4">
                <span class="svc-ico">
                  <Icon name={icons[s.key as keyof typeof icons]} size={30} stroke={1.6} />
                </span>
                <span class="text-sm font-bold text-brand-700/60 tabular-nums">0{i + 1}</span>
              </div>
              <h2 id={`${s.key}-title`} class="mt-5 text-2xl font-extrabold tracking-[-0.02em] text-brand-950 md:text-[1.9rem]">
                {s.title}
              </h2>
              {s.key === 'delivery' && (
                <p class="mt-3 inline-flex items-center gap-1.5 rounded-full bg-saffron-50 px-3 py-1.5 text-[0.8125rem] font-bold text-saffron-700 ring-1 ring-saffron-100">
                  <Icon name="phone" size={14} stroke={2.2} />
                  {d.services.confirm}
                </p>
              )}
              {s.body.map((para) => (
                <p class="mt-4 leading-relaxed text-ink-soft">{para}</p>
              ))}
            </div>
            <div class="steps">
              <h3 class="text-xs font-bold tracking-[0.12em] text-brand-700 uppercase">{p.howTitle}</h3>
              <ol class="mt-4 grid gap-3">
                {s.steps.map((step, j) => (
                  <li class="flex items-start gap-3">
                    <span class="step-num">{j + 1}</span>
                    <span class="pt-1 text-[0.95rem] leading-snug text-brand-950">{step}</span>
                  </li>
                ))}
              </ol>
              <div class="mt-6 flex flex-wrap gap-2">
                <a href={telHref} class="btn btn-call !min-h-11 !text-sm">
                  <Icon name="phone" size={17} stroke={2} />
                  {d.cta.callShort}
                </a>
                <a href={whatsappHref(lang)} target="_blank" rel="noopener" class="btn btn-wa !min-h-11 !text-sm">
                  <Icon name="whatsapp" size={17} stroke={2} />
                  {d.cta.whatsapp}
                </a>
              </div>
            </div>
          </div>
        </section>
      ))
    }

    <aside class="cta-band" data-reveal>
      <div>
        <h2 class="text-2xl font-extrabold tracking-[-0.02em] text-white md:text-3xl">{p.ctaTitle}</h2>
        <p class="mt-2 text-mint-100/85">{p.ctaText}</p>
      </div>
      <div class="flex flex-col gap-3 sm:flex-row">
        <a href={telHref} class="btn btn-call"><Icon name="phone" size={18} stroke={2} />{d.cta.call}</a>
        <a href={business.links.maps} target="_blank" rel="noopener" class="btn bg-white/10 text-white ring-1 ring-white/20 hover:bg-white/15">
          <Icon name="directions" size={18} stroke={2} />{d.cta.directions}
        </a>
      </div>
    </aside>
  </div>
</Base>

<style>
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0 1rem;
    border-radius: 999px;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-brand-900);
    background: rgb(255 255 255 / 0.8);
    box-shadow: inset 0 0 0 1px var(--color-mint-200);
    transition: background-color 200ms;
  }
  .chip :global(svg) {
    color: var(--color-brand-700);
  }
  .chip:hover {
    background: #fff;
  }
  .svc-block {
    padding: 1.75rem 1.5rem;
    border-radius: 1.75rem;
    scroll-margin-top: 6rem;
  }
  @media (min-width: 768px) {
    .svc-block {
      padding: 2.5rem;
    }
  }
  .svc-ico {
    display: grid;
    place-items: center;
    width: 3.75rem;
    height: 3.75rem;
    border-radius: 1.2rem;
    background: var(--color-mint-100);
    color: var(--color-brand-700);
  }
  .steps {
    padding: 1.5rem;
    border-radius: 1.25rem;
    background: var(--color-mint-50);
    box-shadow: inset 0 0 0 1px var(--color-mint-100);
  }
  .step-num {
    display: grid;
    place-items: center;
    flex: none;
    width: 1.9rem;
    height: 1.9rem;
    border-radius: 999px;
    background: var(--color-brand-700);
    color: #fff;
    font-size: 0.85rem;
    font-weight: 800;
  }
  .cta-band {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding: 2rem 1.5rem;
    border-radius: 1.75rem;
    background:
      radial-gradient(60% 120% at 100% 0%, rgb(26 161 146 / 0.4), transparent 60%),
      var(--color-brand-950);
  }
  @media (min-width: 768px) {
    .cta-band {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      padding: 2.5rem;
    }
  }
</style>

---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import MapEmbed from '../components/MapEmbed.astro';
import HoursTable from '../components/HoursTable.astro';
import OpenBadge from '../components/OpenBadge.astro';
import { business, telHref, whatsappHref } from '../data/business';
import { t, type Lang } from '../i18n/ui';
import { pathFor } from '../lib/routes';
import { pharmacySchema, breadcrumbSchema } from '../lib/schema';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);
const c = d.contactPage;

const schema = [
  pharmacySchema({ lang }),
  breadcrumbSchema([
    { name: d.breadcrumbs.home, path: pathFor('home', lang) },
    { name: d.breadcrumbs.contact, path: pathFor('contact', lang) },
  ]),
];
---

<Base lang={lang} routeKey="contact" title={d.meta.contact.title} description={d.meta.contact.description} schema={schema}>
  <PageHeader lang={lang} current={d.breadcrumbs.contact} eyebrow={c.eyebrow} title={c.h1} intro={c.intro}>
    <div class="mt-6"><OpenBadge lang={lang} /></div>
  </PageHeader>

  <div class="container-x pb-20 md:pb-28">
    <ul class="-mt-4 grid gap-4 md:grid-cols-3">
      <li data-reveal style="--d:0">
        <a href={telHref} class="method card method-call">
          <span class="method-ico bg-saffron-50! text-saffron-500!"><Icon name="phone" size={24} /></span>
          <span class="mt-5 block text-lg font-bold text-brand-950">{c.callTitle}</span>
          <span class="mt-1 block text-[0.95rem] text-ink-soft">{c.callText}</span>
          <span class="mt-4 block text-xl font-extrabold tracking-[-0.01em] text-brand-950">{business.phone.display}</span>
        </a>
      </li>
      <li data-reveal style="--d:1">
        <a href={whatsappHref(lang)} target="_blank" rel="noopener" class="method card">
          <span class="method-ico"><Icon name="whatsapp" size={24} /></span>
          <span class="mt-5 block text-lg font-bold text-brand-950">{c.waTitle}</span>
          <span class="mt-1 block text-[0.95rem] text-ink-soft">{c.waText}</span>
          <span class="mt-4 inline-flex items-center gap-1.5 font-bold text-brand-700">{d.cta.whatsapp} <Icon name="arrow" size={18} /></span>
        </a>
      </li>
      <li data-reveal style="--d:2">
        <a href={business.links.maps} target="_blank" rel="noopener" class="method card">
          <span class="method-ico"><Icon name="pin" size={24} /></span>
          <span class="mt-5 block text-lg font-bold text-brand-950">{c.visitTitle}</span>
          <address class="mt-1 block text-[0.95rem] leading-relaxed text-ink-soft not-italic">{business.address.full}</address>
          <span class="mt-4 inline-flex items-center gap-1.5 font-bold text-brand-700">{d.cta.directions} <Icon name="arrow" size={18} /></span>
        </a>
      </li>
    </ul>

    <div class="mt-10 grid gap-5 lg:grid-cols-[1.1fr_1fr]">
      <section class="card p-6 md:p-8" aria-labelledby="form-title" data-reveal>
        <h2 id="form-title" class="text-2xl font-extrabold tracking-[-0.02em] text-brand-950">{c.formTitle}</h2>
        <p class="mt-2 text-[0.95rem] text-ink-soft">{c.formIntro}</p>
        <form class="mt-6 grid gap-5" data-wa-form data-greeting={c.greeting} data-required={c.required} action={`https://wa.me/${business.whatsapp.number}`} method="get" target="_blank">
          <div class="grid gap-2">
            <label for="wa-name" class="font-semibold text-brand-950">
              {c.nameLabel} <span class="font-normal text-ink-soft">{c.optional}</span>
            </label>
            <input id="wa-name" name="name" type="text" autocomplete="name" placeholder={c.namePlaceholder} class="field" />
          </div>
          <div class="grid gap-2">
            <label for="wa-msg" class="font-semibold text-brand-950">{c.msgLabel}</label>
            <textarea id="wa-msg" name="text" rows="5" required placeholder={c.msgPlaceholder} class="field resize-y"></textarea>
          </div>
          <button type="submit" class="btn btn-wa justify-self-start !px-6">
            <Icon name="send" size={19} stroke={2} />
            {c.submit}
          </button>
        </form>
      </section>

      <div class="grid gap-5">
        <MapEmbed lang={lang} class="min-h-[18rem]" />
        <section class="card p-6" aria-labelledby="hours-title" data-reveal>
          <h2 id="hours-title" class="flex items-center gap-2 text-lg font-bold text-brand-950">
            <Icon name="clock" size={20} class="text-brand-700" />
            {c.hoursTitle}
          </h2>
          <div class="mt-3 -mx-3"><HoursTable lang={lang} /></div>
          <p class="mt-4 text-sm text-ink-soft">{d.visit.plusCode}: <span class="font-semibold text-brand-900">{business.plusCode}</span></p>
        </section>
      </div>
    </div>
  </div>
</Base>

<style>
  .method {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 1.5rem;
    border-radius: 1.5rem;
    transition:
      transform 300ms var(--ease-out-soft),
      box-shadow 300ms var(--ease-out-soft);
  }
  .method:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lift);
  }
  .method-ico {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 1rem;
    background: var(--color-mint-100);
    color: var(--color-brand-700);
  }
  .field {
    width: 100%;
    min-height: 3rem;
    padding: 0.75rem 1rem;
    border-radius: 0.9rem;
    background: var(--color-paper);
    border: 1.5px solid var(--color-line);
    color: var(--color-ink);
    font-size: 1rem;
    transition:
      border-color 200ms,
      box-shadow 200ms;
  }
  .field::placeholder {
    color: #7a8a87;
  }
  .field:focus {
    outline: none;
    border-color: var(--color-brand-600);
    box-shadow: 0 0 0 4px rgb(26 161 146 / 0.18);
  }
</style>

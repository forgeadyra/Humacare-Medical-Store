---
import { Image } from 'astro:assets';
import SectionHead from './SectionHead.astro';
import storeFront from '../assets/images/store-front.jpg';
import counter from '../assets/images/counter.jpg';
import shelves from '../assets/images/shelves.jpg';
import interior1 from '../assets/images/interior-1.jpg';
import interior2 from '../assets/images/interior-2.jpg';
import { t, type Lang } from '../i18n/ui';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang).gallery;

// TODO(owner): these are placeholders — replace the files in src/assets/images/ with real photos (same names).
const photos = [
  { src: storeFront, alt: d.items.storeFront },
  { src: counter, alt: d.items.counter },
  { src: shelves, alt: d.items.shelves },
  { src: interior1, alt: d.items.interior1 },
  { src: interior2, alt: d.items.interior2 },
];
---

<section id="gallery" class="bg-paper-2 py-20 md:py-28" aria-labelledby="gallery-title">
  <div class="container-x">
    <SectionHead id="gallery-title" eyebrow={d.eyebrow} title={d.title} lede={d.lede} />
    <ul class="bento mt-12">
      {
        photos.map((p, i) => (
          <li class:list={['tile', i === 0 && 'tile-hero']} data-reveal style={`--d:${i % 3}`}>
            <Image
              src={p.src}
              alt={p.alt}
              widths={[360, 560, 800]}
              sizes={i === 0 ? '(min-width: 1024px) 600px, 100vw' : '(min-width: 1024px) 300px, 50vw'}
              loading="lazy"
              decoding="async"
              class="h-full w-full object-cover"
            />
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* Masonry-style bento: one feature tile + four supporting tiles, always balanced. */
  .bento {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-auto-rows: 9.5rem;
    gap: 0.75rem;
  }
  .tile-hero {
    grid-column: 1 / -1;
    grid-row: span 2;
  }
  @media (min-width: 640px) {
    .bento {
      grid-auto-rows: 12rem;
    }
  }
  @media (min-width: 1024px) {
    .bento {
      grid-template-columns: 1.6fr 1fr 1fr;
      grid-auto-rows: 15rem;
      gap: 1.25rem;
    }
    .tile-hero {
      grid-column: 1;
      grid-row: span 2;
    }
  }
  .tile {
    overflow: hidden;
    border-radius: 1.25rem;
    background: var(--color-mint-100);
    box-shadow: var(--shadow-soft);
  }
  @media (min-width: 1024px) {
    .tile {
      border-radius: 1.5rem;
    }
  }
  .tile :global(img) {
    transition: transform 600ms var(--ease-out-soft);
  }
  .tile:hover :global(img) {
    transform: scale(1.04);
  }
</style>

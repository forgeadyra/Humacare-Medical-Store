---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { business, telHref, whatsappHref, hoursLabel } from '../data/business';
import { t, type Lang } from '../i18n/ui';
import { pathFor, homeAnchor } from '../lib/routes';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);
const year = new Date().getFullYear();
const quick = [
  { href: pathFor('home', lang), label: d.nav.home },
  { href: pathFor('services', lang), label: d.nav.services },
  { href: homeAnchor(lang, 'reviews'), label: d.nav.reviews },
  { href: homeAnchor(lang, 'visit'), label: d.nav.visit },
  { href: homeAnchor(lang, 'faq'), label: d.faq.eyebrow },
  { href: pathFor('contact', lang), label: d.nav.contact },
];
---

<footer class="relative overflow-hidden bg-brand-950 text-mint-100">
  <div class="footer-glow" aria-hidden="true"></div>
  <div class="container-x relative grid gap-10 py-14 md:grid-cols-2 md:py-16 lg:grid-cols-[1.35fr_0.8fr_1.2fr_0.9fr]">
    <div>
      <Logo lang={lang} tone="light" />
      <p class="mt-5 max-w-sm text-[0.95rem] leading-relaxed text-mint-200/90">{d.footer.about}</p>
      <a
        href={business.links.maps}
        target="_blank"
        rel="noopener"
        class="mt-5 inline-flex min-h-11 items-center gap-2.5 rounded-full bg-white/[0.07] px-4 text-sm font-semibold text-white ring-1 ring-white/10 transition-colors hover:bg-white/[0.12]"
      >
        <Icon name="google" size={16} />
        <span class="flex items-center gap-1 text-saffron-300"><Icon name="star" size={15} />{business.rating.value}</span>
        <span class="text-mint-200">· {d.reviews.basedOn}</span>
      </a>
    </div>

    <nav aria-label={d.footer.quick}>
      <h2 class="footer-h">{d.footer.quick}</h2>
      <ul class="mt-4 grid grid-cols-2 gap-x-4 md:grid-cols-1">
        {quick.map((q) => <li><a href={q.href} class="footer-link">{q.label}</a></li>)}
      </ul>
    </nav>

    <div>
      <h2 class="footer-h">{d.footer.reach}</h2>
      <address class="mt-4 not-italic">
        <p class="font-bold text-white">{business.name}</p>
        <p class="mt-1.5 text-[0.95rem] leading-relaxed text-mint-200/90">{business.address.full}</p>
        <p class="mt-1.5 text-sm text-mint-200/70">{d.visit.plusCode}: {business.plusCode}</p>
        <ul class="mt-3 grid gap-1">
          <li>
            <a href={telHref} class="footer-link !text-white"><Icon name="phone" size={18} class="text-saffron-300" />{business.phone.display}</a>
          </li>
          <li>
            <a href={whatsappHref(lang)} target="_blank" rel="noopener" class="footer-link"><Icon name="whatsapp" size={18} class="text-mint-300" />WhatsApp</a>
          </li>
          <li>
            <a href={business.links.maps} target="_blank" rel="noopener" class="footer-link"><Icon name="directions" size={18} class="text-mint-300" />{d.cta.directions}</a>
          </li>
        </ul>
      </address>
    </div>

    <div>
      <h2 class="footer-h">{d.footer.hours}</h2>
      <p class="mt-4 font-semibold text-white">{d.footer.everyday}</p>
      <p class="mt-1 text-[0.95rem] text-mint-200/90">{hoursLabel(lang)}</p>
    </div>
  </div>

  <div class="relative border-t border-white/10">
    <div class="container-x grid gap-4 pt-7 pb-[calc(6.5rem+env(safe-area-inset-bottom))] md:pb-7 text-[0.8125rem] leading-relaxed text-mint-200/75 md:grid-cols-[1fr_auto] md:items-end">
      <div class="grid gap-2">
        <p><span class="font-semibold text-mint-100">{d.footer.licence}</span> {business.drugLicence}</p>
        <p class="max-w-2xl">{d.footer.disclaimer}</p>
        <p>© {year} {business.name}. {d.footer.rights}</p>
      </div>
      <p class="md:text-right">
        {d.footer.madeBy}{' '}
        <span class="font-semibold text-white">{business.credit.name}</span>
      </p>
    </div>
  </div>
</footer>

<style>
  .footer-glow {
    position: absolute;
    inset: -40% -20% auto auto;
    width: 38rem;
    height: 38rem;
    border-radius: 999px;
    background: radial-gradient(closest-side, rgb(26 161 146 / 0.22), transparent);
    pointer-events: none;
  }
  .footer-h {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-mint-300);
  }
  :global(html[lang='hi']) .footer-h {
    letter-spacing: 0.02em;
    font-size: 0.875rem;
  }
  .footer-link {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 2.75rem;
    color: var(--color-mint-100);
    font-size: 0.95rem;
    transition: color 200ms;
  }
  .footer-link:hover {
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>

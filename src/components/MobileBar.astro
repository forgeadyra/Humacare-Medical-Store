---
import Icon from './Icon.astro';
import { business, telHref, whatsappHref } from '../data/business';
import { t, type Lang } from '../i18n/ui';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);
---

<nav aria-label={d.mobileBar.label} class="mobile-bar md:hidden">
  <div class="bar-inner">
    <a href={telHref} class="bar-btn bar-call">
      <span class="bar-ico"><Icon name="phone" size={20} stroke={2} /></span>
      <span>{d.cta.callShort}</span>
    </a>
    <a href={whatsappHref(lang)} target="_blank" rel="noopener" class="bar-btn bar-wa">
      <span class="bar-ico"><Icon name="whatsapp" size={20} stroke={2} /></span>
      <span>{d.cta.whatsapp}</span>
    </a>
    <a href={business.links.maps} target="_blank" rel="noopener" class="bar-btn bar-dir">
      <span class="bar-ico"><Icon name="directions" size={19} stroke={2} /></span>
      <span>{d.cta.directionsShort}</span>
    </a>
  </div>
</nav>

<style>
  .mobile-bar {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 60;
    padding: 0.5rem 0.75rem calc(0.5rem + env(safe-area-inset-bottom));
    background: linear-gradient(to top, rgb(251 248 243 / 1) 55%, rgb(251 248 243 / 0));
    pointer-events: none;
  }
  .bar-inner {
    pointer-events: auto;
    display: grid;
    grid-template-columns: 1.25fr 1fr 1fr;
    gap: 0.4rem;
    padding: 0.4rem;
    border-radius: 1.4rem;
    background: var(--color-brand-950);
    box-shadow:
      0 10px 30px -10px rgb(4 47 44 / 0.55),
      0 2px 6px rgb(4 47 44 / 0.2);
  }
  .bar-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    min-height: 3.25rem;
    border-radius: 1.05rem;
    font-weight: 700;
    font-size: 0.9375rem;
    color: #fff;
    -webkit-tap-highlight-color: transparent;
    transition:
      transform 160ms var(--ease-out-soft),
      background-color 160ms;
  }
  .bar-btn:active {
    transform: scale(0.96);
  }
  .bar-ico {
    display: grid;
    place-items: center;
  }
  .bar-call {
    background: linear-gradient(180deg, var(--color-saffron-300), var(--color-saffron-400));
    color: #2b1700;
    box-shadow: 0 1px 0 rgb(255 255 255 / 0.45) inset;
  }
  .bar-wa {
    background: rgb(255 255 255 / 0.08);
  }
  .bar-wa .bar-ico {
    color: var(--color-mint-300);
  }
  .bar-dir {
    background: rgb(255 255 255 / 0.08);
  }
  .bar-dir .bar-ico {
    color: var(--color-mint-300);
  }
  .bar-wa:hover,
  .bar-dir:hover {
    background: rgb(255 255 255 / 0.14);
  }
</style>

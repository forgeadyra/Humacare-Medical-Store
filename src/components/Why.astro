---
import Icon from './Icon.astro';
import { business } from '../data/business';
import { t, type Lang } from '../i18n/ui';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang).why;
const icons = ['shield', 'tag', 'heart'] as const;
// Highlight each "genuine" in the Google summary line.
const parts = business.tagline.split(/(genuine)/i);
---

<section id="why" class="px-3 md:px-5" aria-labelledby="why-title">
  <div class="why-shell">
    <div class="why-glow" aria-hidden="true"></div>
    <div class="container-x relative py-16 md:py-24">
      <div class="grid gap-10 lg:grid-cols-[1fr_1.1fr] lg:items-end">
        <div data-reveal>
          <p class="eyebrow text-mint-300!">{d.eyebrow}</p>
          <h2 id="why-title" class="section-title mt-3 text-white!">{d.title}</h2>
        </div>
        <div data-reveal style="--d:1">
          <p class="why-quote" lang="en">
            <span aria-hidden="true" class="text-saffron-300">“</span>{
              parts.map((p) => (/genuine/i.test(p) ? <em class="not-italic text-saffron-300">{p}</em> : p))
            }<span aria-hidden="true" class="text-saffron-300">”</span>
          </p>
          <p class="mt-3 flex items-center gap-2 text-sm text-mint-200/80">
            <Icon name="google" size={14} />
            {lang === 'hi' ? 'Google रिव्यू सारांश' : 'Google review summary'}
          </p>
        </div>
      </div>
      <p class="lede mt-8 max-w-2xl text-mint-100/85!" data-reveal>{d.lede}</p>

      <ol class="mt-12 grid gap-4 md:grid-cols-3 md:gap-5">
        {
          d.points.map((p, i) => (
            <li class="why-card" data-reveal style={`--d:${i}`}>
              <div class="flex items-center justify-between">
                <span class="why-ico">
                  <Icon name={icons[i]} size={24} />
                </span>
                <span class="text-sm font-bold text-mint-300/70 tabular-nums">0{i + 1}</span>
              </div>
              <span class="mt-6 inline-flex rounded-full bg-saffron-400/15 px-3 py-1 text-[0.8125rem] font-bold text-saffron-300 ring-1 ring-saffron-300/25" lang="en">
                {p.pill}
              </span>
              <h3 class="mt-3 text-xl font-bold tracking-[-0.015em] text-white">{p.title}</h3>
              <p class="mt-2 leading-relaxed text-mint-100/80">{p.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .why-shell {
    position: relative;
    overflow: hidden;
    border-radius: 2rem;
    background:
      radial-gradient(60% 80% at 100% 0%, rgb(26 161 146 / 0.35), transparent 60%),
      radial-gradient(50% 60% at 0% 100%, rgb(15 118 110 / 0.5), transparent 60%),
      var(--color-brand-950);
    color: #fff;
  }
  @media (min-width: 768px) {
    .why-shell {
      border-radius: 2.5rem;
    }
  }
  .why-glow {
    position: absolute;
    inset: 0;
    opacity: 0.5;
    background-image: radial-gradient(rgb(255 255 255 / 0.07) 1px, transparent 1px);
    background-size: 22px 22px;
    mask-image: linear-gradient(to bottom, #000, transparent 70%);
  }
  .why-quote {
    font-size: clamp(1.45rem, 1rem + 1.8vw, 2.1rem);
    line-height: 1.25;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #fff;
    text-wrap: balance;
  }
  .why-card {
    padding: 1.5rem;
    border-radius: 1.5rem;
    background: rgb(255 255 255 / 0.05);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.09);
    transition:
      transform 300ms var(--ease-out-soft),
      background-color 300ms;
  }
  .why-card:hover {
    transform: translateY(-4px);
    background: rgb(255 255 255 / 0.08);
  }
  .why-ico {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 1rem;
    background: rgb(154 219 197 / 0.14);
    color: var(--color-mint-300);
  }
</style>
